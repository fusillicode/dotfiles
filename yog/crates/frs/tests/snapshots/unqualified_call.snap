    }
}

pub mod remove_nested_group {
    use std::mem;
    use std::{

        fs::File,
    };
    fn run(_: File) {
        mem::drop(1);
        mem::size_of::<u8>();
    }
}

pub mod retain_nested_group_reference {
    use std::mem;
    use std::{
        mem::{
             size_of as size_of_retain_nested_group_reference,

        },
        fs::File,
    };
    fn run(_: File) {
        let f = size_of_retain_nested_group_reference::<u8>;
        mem::drop(1);
        mem::align_of::<u8>();
        let _ = f();
    }
}

